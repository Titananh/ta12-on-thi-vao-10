# =============================================================================
# TA12 Dedicated Admin Portal - Environment Variables Template
# =============================================================================

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Admin Session HMAC Security Secret (64-character hex string recommended)
AUTH_SECRET=ta12_admin_super_secret_portal_2026_high_security_key

# Superadmin Email & Master Key (Only dot71714@gmail.com is granted access)
SUPERADMIN_EMAIL=dot71714@gmail.com
ADMIN_MASTER_KEY=ta12_superadmin_secret_key_2026

# Server Port & Inter-App URLs
PORT=3001
NEXT_PUBLIC_STUDENT_PORTAL_URL=http://localhost:3000
