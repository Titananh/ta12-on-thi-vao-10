# ==============================================================================
# TA12 Platform - Official .gitignore
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js Build Outputs & Caches
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts.bak

# Debug & Execution Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Environment Variables & Secret Configuration
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example

# SQLite Database Runtimes & Transaction Journals
*.sqlite
*.sqlite3
*.db
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db-journal
data/*.sqlite*
data/*.db*

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/

# OS Metadata & IDE Workspace Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Teamwork Agent Transient Logs & Scratchpads
.agents/

# Caches & Test Coverages
.cache/
.eslintcache
coverage/
.vercel
