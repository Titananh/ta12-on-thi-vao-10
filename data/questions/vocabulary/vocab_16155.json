      ],
      "correctChoiceId": 1715802,
      "fillblankAnswers": null,
      "shortAnswers": null,
      "hint": "Để tìm từ trái nghĩa, hãy nghĩ xem <em>\"ill\"</em> có nghĩa là gì trong câu: <em>\"people who are ill\"</em>. Từ này có nghĩa tương tự như <em>\"unwell\"</em>. Vậy, từ nào trong các lựa chọn có nghĩa đối lập với <em>\"unwell\"</em>?",
      "explanation": "<p><span class=\"eq-highlight\">Giải nghĩa từ vựng:</span> </p>\n<style>\n    .vocab-table-sharp-wrapper {\n        width: 100%;\n        background-color: #fff; \n        border: 1px solid #ceedca;\n        border-radius: 10px; \n        overflow: hidden;\n    }\n\n    .vocab-table-sharp {\n        width: 100%;\n        border-collapse: collapse;\n        text-align: left;\n        table-layout: fixed;\n        color: #1c581f;\n        font-size: 15px;\n    }\n\n    .vocab-table-sharp th, \n    .vocab-table-sharp td {\n        padding: 0.5rem 0.8rem;\n    }\n\n    .vocab-table-sharp th {\n        background-color: #f5f5f5; \n        font-weight: bold;\n        border-bottom: 2px solid #5fbd18;\n    }\n\n    .vocab-table-sharp td {\n        border-bottom: 1px solid #ceedca;\n        vertical-align: middle; \n    }\n\n    .vocab-table-sharp tr:last-child td {\n        border-bottom: none;\n    }\n    \n    .word-en-sharp {\n        display: inline-block;\n        margin: 0 0.4rem 4px 0;\n    }\n\n    .word-pos-sharp {\n        color: #57aa19;\n    }\n\n    .word-ipa-sharp {\n        color: #555;\n        display: block;\n    }\n</style>\n<div class=\"vocab-table-sharp-wrapper\">\n<table class=\"vocab-table-sharp\">\n<thead>\n<tr>\n<th style=\"width: 50%;\">Từ</th>\n<th style=\"width: 50%;\">Nghĩa</th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"background-color: #e5f6e3;\">\n<td><strong><span class=\"word-en-sharp\">ill</span></strong><span class=\"word-pos-sharp\">(adj.)</span> <span class=\"word-ipa-sharp\">/ɪl/</span></td>\n<td><span style=\"color: #7e8c8d;\"><em>ốm, bệnh</em></span></td>\n</tr>\n<tr>\n<td><strong><span class=\"word-en-sharp\">patient</span></strong><span class=\"word-pos-sharp\">(n.)</span> <span class=\"word-ipa-sharp\">/'peɪʃənt/</span></td>\n<td><span style=\"color: #7e8c8d;\"><em>bệnh nhân</em></span></td>\n</tr>\n<tr>\n<td><strong><span class=\"word-en-sharp\">patient</span></strong><span class=\"word-pos-sharp\">(adj.)</span> <span class=\"word-ipa-sharp\">/'peɪʃənt/</span></td>\n<td><span style=\"color: #7e8c8d;\"><em>kiên nhẫn</em></span></td>\n</tr>\n<tr>\n<td><strong><span class=\"word-en-sharp\">unusual</span></strong><span class=\"word-pos-sharp\">(adj.)</span> <span class=\"word-ipa-sharp\">/ʌnˈjuːʒuəl/</span></td>\n<td><span style=\"color: #7e8c8d;\"><em>không bình thường, khác thường</em></span></td>\n</tr>\n<tr style=\"background-color: #e5f6e3;\">\n<td><strong><span class=\"word-en-sharp\">healthy</span></strong><span class=\"word-pos-sharp\">(adj.)</span> <span class=\"word-ipa-sharp\">/ˈhelθi/</span></td>\n<td><span style=\"color: #7e8c8d;\"><em>khỏe mạnh, lành mạnh</em></span></td>\n</tr>\n<tr>\n<td><strong><span class=\"word-en-sharp\">sick</span></strong><span class=\"word-pos-sharp\">(adj.)</span> <span class=\"word-ipa-sharp\">/sɪk/</span></td>\n<td><span style=\"color: #7e8c8d;\"><em>ốm, bệnh</em></span></td>\n</tr>\n</tbody>\n</table>\n</div>\n<p style=\"text-align: justify;\"><span class=\"eq-highlight\" style=\"color: #5fbd18;\"><br />Phân tích:</span><span style=\"text-align: justify;\"> </span><span style=\"text-align: justify;\">Từ <strong>ill</strong> trong câu có nghĩa là \"ốm yếu, bệnh tật\" khi nói về tình trạng sức khỏe của con người. Để tìm từ trái nghĩa, bạn cần một từ diễn tả tình trạng sức khỏe tốt. Phương án <strong>healthy</strong> có nghĩa là \"khỏe mạnh\", đối lập hoàn toàn với <strong>ill</strong>. </span></p>\n<p style=\"text-align: justify;\"><span style=\"text-align: justify;\">Các phương án khác không phù hợp vì <strong>patient</strong> có thể là danh từ chỉ người bệnh hoặc tính từ chỉ sự kiên nhẫn, không phải trái nghĩa; <strong>unusual</strong> có nghĩa là \"khác thường\", không liên quan đến sức khỏe; và <strong>sick</strong> là từ đồng nghĩa với, không phải trái nghĩa.</span></p>",
      "answerFeedbacks": {
        "1715800": "Từ <strong>patient</strong> (danh từ) có nghĩa là \"bệnh nhân\", không phải từ trái nghĩa với <em>\"ill\"</em>.",
        "1715801": "Từ <strong>unusual</strong> có nghĩa là \"khác thường\", không liên quan đến tình trạng sức khỏe của một người.",
        "1715802": "Từ <strong>healthy</strong> có nghĩa là \"khỏe mạnh\", hoàn toàn trái ngược với <em>\"ill\"</em> (ốm yếu).",
        "1715803": "Từ <strong>sick</strong> là từ đồng nghĩa với <em>\"ill\"</em>, cả hai đều có nghĩa là \"ốm yếu\"."
      },
